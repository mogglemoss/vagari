/* ── Ministry warm dark palette (shared with HARUSPEX) ── */
$rust:        #C15F3C;
$rust-dim:    #8A3820;
$warm-bg:     #1a1815;
$warm-surface:#201d18;
$warm-panel:  #252118;
$warm-text:   #e8e6e3;
$warm-muted:  #7a756e;
$warm-border: #3a3530;

Screen {
    background: $warm-bg;
    color: $warm-text;
}

Footer {
    background: $warm-surface;
    color: $warm-muted;
}
FooterKey {
    background: $warm-surface;
    color: $warm-muted;
}
FooterKey:hover {
    background: $rust 30%;
    color: $warm-text;
}
FooterKey > .footer-key--key {
    color: #d4a017;
    background: $warm-surface;
}
FooterKey:hover > .footer-key--key {
    background: $rust 30%;
}
FooterKey > .footer-key--description {
    color: $warm-muted;
}

#body {
    height: 1fr;
}

#chain-tree, #detail-panel {
    border: round $warm-border;
    border-title-color: $warm-muted;
    border-title-style: bold;
}
#chain-tree:focus, #detail-panel:focus {
    border: round $rust;
    border-title-color: $rust;
}

#chain-tree {
    scrollbar-color: #2f2b26;          /* faint rail, not a grey bar */
    scrollbar-color-hover: #C15F3C;
    scrollbar-color-active: #C15F3C;
    scrollbar-background: transparent;

    width: 3fr;
    padding: 0 1;
    background: $warm-bg;
}

#detail-panel {
    width: 2fr;
    height: 100%;
    padding: 1 2;
    background: $warm-surface;
    border-left: solid $warm-border;
}

#status-line {
    height: 1;
    background: $warm-surface;
    color: $warm-muted;
    padding: 0 1;
}

#command-bar {
    height: 1;
    background: $warm-panel;
    border: none;
    color: $warm-text;
    padding: 0 1;
}
#command-bar:focus {
    border: none;
    background: $warm-panel;
}
#command-bar > .input--cursor {
    background: $rust;
    color: $warm-bg;
}
#command-bar > .input--placeholder {
    color: $warm-muted;
}

/* Command palette — Ministry issue, not factory default */
CommandPalette {
    background: $warm-surface 40%;
}
CommandPalette > Vertical {
    background: $warm-surface;
    border: round $warm-border;
}
CommandPalette > .command-palette--highlight {
    color: $rust;
    text-style: bold;
}
CommandPalette Input {
    background: $warm-panel;
    border: tall $warm-border;
    color: $warm-text;
}
CommandPalette Input:focus {
    border: tall $rust;
}
CommandPalette OptionList {
    background: $warm-surface;
    border: none;
}
/* CommandList's own defaults and OptionList:focus outrank plain
   type selectors — match every state explicitly or the factory blue
   leaks back in on hover and focused-highlight. */
CommandPalette OptionList > .option-list--option-highlighted,
CommandPalette OptionList:focus > .option-list--option-highlighted,
CommandPalette CommandList > .option-list--option-highlighted,
CommandPalette CommandList:focus > .option-list--option-highlighted {
    background: $rust 20%;
    color: $warm-text;
    text-style: none;
}
CommandPalette OptionList > .option-list--option-hover,
CommandPalette CommandList > .option-list--option-hover {
    background: $rust 12%;
}
OptionList > .option-list--option-hover {
    background: $rust 12%;
}
OptionList:focus > .option-list--option-highlighted {
    background: $rust 20%;
    color: $warm-text;
}

/* Action links (dossier verbs, candidate types, header badges):
   hover must glow rust, never factory blue. Base link colors come from
   the surrounding markup, so only the hover states are pinned here. */
* {
    link-background-hover: $rust 30%;
    link-color-hover: $warm-text;
    link-style-hover: bold;
}

/* Input text selection — same treatment. */
#command-bar > .input--selection {
    background: $rust 35%;
}

/* Kill the default blue focus ring everywhere */
*:focus {
    border: round $warm-border;
    outline: none;
}

Tree {
    background: $warm-bg;
}
Tree:focus {
    border: none;
    background: $warm-bg;
}
Tree > .tree--cursor {
    background: $rust 25%;
    color: $warm-text;
}
Tree > .tree--highlight {
    background: $rust 12%;
}
Tree > .tree--highlight-line {
    background: $warm-panel;
}
Tree > .tree--guides {
    color: $warm-border;
}
Tree > .tree--guides-hover {
    color: $rust-dim;
}
Tree > .tree--guides-selected {
    color: $rust;
}

/* Warm scrollbars — Textual defaults to blue */
* {
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
    scrollbar-color: #5a5550;
    scrollbar-background: $warm-bg;
    scrollbar-color-hover: $rust;
    scrollbar-background-hover: $warm-bg;
    scrollbar-color-active: $rust;
    scrollbar-background-active: $warm-bg;
}

/* Watchtower pulse: the map's frame runs hot for a moment. */
#chain-tree.alerting {
    border: heavy #d4a017;
}

Toast {
    background: $warm-panel;
    border: round $warm-border;
}
Toast.-information {
    border: round $warm-muted;
}
Toast.-warning {
    border: round #d4a017;
}
Toast.-error {
    border: round $rust;
}
Toast .toast--title {
    color: $warm-text;
}

/* Dossier widgets */
#dossier-head {
    height: auto;
}
#dossier-body {
    height: auto;
    margin: 1 0 0 0;
}
#dossier-sigs-header {
    height: auto;
    margin: 1 0 0 0;
}
#dossier-eol-label {
    height: auto;
    margin: 1 1 0 1;
}
#dossier-eol {
    height: 3;
    color: #d4a017;
    margin: 0 0 0 1;
}
#dossier-trend {
    height: 1;
    margin: 0 1;
}
#dossier-trend > .sparkline--max-color {
    color: #d4a017;
}
#dossier-trend > .sparkline--min-color {
    color: #3a3530;
}
#dossier-form-label {
    height: auto;
    margin: 1 1 0 1;
}
#dossier-form {
    height: 1;
    background: $warm-panel;
    border: none;
    color: $warm-text;
    margin: 0 1 0 1;
    padding: 0 1;
}
#dossier-form:focus {
    border: none;
    background: $warm-surface;
}
#dossier-form > .input--cursor {
    background: $rust;
    color: $warm-bg;
}
#dossier-form > .input--placeholder {
    color: $warm-muted;
}
#dossier-form > .input--selection {
    background: $rust 35%;
}
/* DataTable — de-blue every stateful part (ported from HARUSPEX). */
DataTable {
    background: transparent;
    color: $warm-text;
}
DataTable > .datatable--header {
    background: $warm-surface;
    color: #a09890;
    text-style: bold;
}
DataTable > .datatable--header-hover {
    background: $warm-surface;
    color: $rust;
}
DataTable > .datatable--cursor {
    background: $rust 25%;
    color: $warm-text;
}
DataTable > .datatable--hover {
    background: $rust 12%;
    color: $warm-text;
}
DataTable > .datatable--even-row {
    background: #1e1b16;
}
DataTable > .datatable--odd-row {
    background: transparent;
}

#dossier-sigs {
    height: auto;
    max-height: 14;
    scrollbar-size-horizontal: 0;  /* names are truncated; no bar needed */
}
